import {
  binary,
  either {Left, Right},
  file.buffer {flush, make-buffer},
  file.descriptor {stdout},
  rune.io.buffer {write-rune, write-rune-line},
  string,
  string.io {print-line},
  system {system},
  unit {Unit, unit},
}

define zen() -> unit {
  let !k = make-buffer(stdout, 4);
  pin k = k;
  let test: system(unit) = {
    try _ = write-rune(k, `a`);
    try _ = write-rune(k, `b`);
    try _ = write-rune(k, `あ`);
    try _ = write-rune-line(k, `α`);
    try _ = write-rune(k, `a`);
    try _ = write-rune(k, `b`);
    try _ = write-rune(k, `あ`);
    try _ = write-rune-line(k, `α`);
    try _ = flush(k);
    Right(Unit)
  };
  match test {
  | Left(_) =>
    print-line("left");
  | Right(_) =>
    print-line("right");
  }
}

import {
  this::list {Cons, Nil, list},
  this::ord {Ord, ord},
  this::ordering {EQ, GT, LT, ordering},
}

inline as-ord<a>(o: ord(a)) -> ord(list(a)) {
  let Ord{compare := !compare-element} = o;
  define compare(xs: &list(a), ys: &list(a)) -> ordering {
    case xs, ys {
    | Nil, Nil =>
      EQ
    | Nil, Cons(_, _) =>
      LT
    | Cons(_, _), Nil =>
      GT
    | Cons(x, xs), Cons(y, ys) =>
      match compare-element(x, y) {
      | LT =>
        LT
      | GT =>
        GT
      | EQ =>
        compare(xs, ys)
      }
    }
  };
  Ord{compare}
}

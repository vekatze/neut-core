import {
  binary,
  doc.show {show-doc},
  show.generic {to-doc},
  string,
  string.io {print},
  unit {unit},
}

inline-meta vet<a>(x: '&a)[ribbon-length := quote {50}] -> 'unit {
  quote {
    pin tmp = unquote {to-doc(x)};
    pin item = show-doc(tmp, unquote {ribbon-length});
    print(item);
    print("\n");
  }
}

inline-meta trace<a>(x: 'a) -> 'a {
  quote {
    let x = unquote {x};
    let _ on x = unquote {vet(quote {x})};
    x
  }
}

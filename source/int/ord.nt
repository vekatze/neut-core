import {
  bool,
  layer,
  ord {Ord, ord},
  ordering {EQ, GT, LT},
}

constant as-ord: ord(int) {
  Ord{
    compare := {
      (x, y) => {
        if gt-int(*x, *y) {
          GT
        } else-if lt-int(*x, *y) {
          LT
        } else {
          EQ
        }
      }
    },
  }
}

constant as-ord-int8: ord(int8) {
  Ord{
    compare := {
      (x, y) => {
        if gt-int8(*x, *y) {
          GT
        } else-if lt-int8(*x, *y) {
          LT
        } else {
          EQ
        }
      }
    },
  }
}

import {
  binary.io.buffer,
  either,
  file.buffer {buffer},
  rune.io.buffer {write-rune},
  string {string, to-binary},
  system {system},
  unit {unit},
}

define write(b: &buffer, content: &string) ->> system(unit) {
  binary.io.buffer.write-binary(b, to-binary(content))
}

define write-line(b: &buffer, content: &string) ->> system(unit) {
  try _ = write(b, content);
  write-rune(b, `\n`)
}

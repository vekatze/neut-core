import {
  this::bool,
  this::c-int {c-int},
  this::c-string {c-string, to-string},
  this::list {Cons, Nil, list},
  this::memory.unsafe {load-pointer},
  this::pointer {shift},
  this::string {string},
  this::unit {unit},
  this::unsafe {cast},
}

foreign {
  exit(c-int) -> void,
  neut-unsafe-argc: int,
  neut-unsafe-argv: pointer,
}

define exit<a>(status: c-int) -> a {
  let _ = magic external exit(status);
  magic cast(type, a, pack-type {unit})
}

define get-argc() -> int {
  magic external neut-unsafe-argc
}

define get-argv() -> list(string) {
  let argc = get-argc();
  let argv = magic external neut-unsafe-argv;
  let u = this::pointer::size;
  let f =
    define get-argv-helper(i: int) -> list(string) {
      if eq-int(i, argc) {
        Nil
      } else {
        let rest = get-argv-helper(add-int(i, 1));
        let str-ptr-ptr = shift(argv, mul-int(i, u));
        let str-ptr = load-pointer(str-ptr-ptr);
        let t = to-string(cast<pointer, &c-string>(str-ptr));
        Cons(t, rest)
      }
    };
  f(0)
}

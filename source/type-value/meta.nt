import {
  this::bool {False, True, bool},
  this::either {Left, Right},
  this::list {Cons, Nil, list},
  this::list.meta {fold-left, length},
  this::memory.unsafe {load-int, load-int16, load-int32, load-int8, load-pointer},
  this::pair {Pair, pair},
  this::pointer {shift},
  this::type-value {
    Algebraic,
    Constructor,
    Direct,
    Field,
    Mixed,
    Width-Pointer,
    Width16,
    Width32,
    Width64,
    Width8,
    constructor,
    field,
    field-layout,
    storage-width,
    type-value,
  },
  this::unit {Unit},
  this::unsafe {cast-inline},
}

inline-meta field-name(f: field) -> text {
  let Field(name, _, _) = f;
  name
}

inline-meta field-type(f: field) -> type {
  let Field(_, t, _) = f;
  t
}

inline-meta field-layout-of(f: field) -> field-layout {
  let Field(_, _, layout) = f;
  layout
}

inline-meta is-direct(layout: field-layout) -> bool {
  match layout {
  | Direct(_) =>
    True
  | Mixed(_) =>
    False
  }
}

inline-meta is-mixed(layout: field-layout) -> bool {
  match layout {
  | Direct(_) =>
    False
  | Mixed(_) =>
    True
  }
}

inline-meta pointer-byte-size() -> int {
  introspect target-arch {
  | wasm32 =>
    4
  | default =>
    8
  }
}

inline-meta storage-width-byte-size(width: storage-width) -> int {
  match width {
  | Width8 =>
    1
  | Width16 =>
    2
  | Width32 =>
    4
  | Width64 =>
    8
  | Width-Pointer =>
    pointer-byte-size()
  }
}

inline-meta field-layout-byte-size(layout: field-layout) -> int {
  match layout {
  | Direct(width) =>
    storage-width-byte-size(width)
  | Mixed(chunks) =>
    fold-left(0, chunks, (acc, c) => {
      add-int(acc, c)
    })
  }
}

inline-meta field-storage-byte-size(f: field) -> int {
  field-layout-byte-size(field-layout-of(f))
}

inline-meta _larger(x: int, y: int) -> int {
  if gt-int(x, y) {
    x
  } else {
    y
  }
}

inline-meta align-up(alignment: int, value: int) -> int {
  add-int(value, rem-int(sub-int(alignment, rem-int(value, alignment)), alignment))
}

inline-meta field-layout-alignment(layout: field-layout) -> int {
  match layout {
  | Direct(width) =>
    storage-width-byte-size(width)
  | Mixed(chunks) =>
    fold-left(1, chunks, (acc, c) => {
      _larger(c, acc)
    })
  }
}

inline-meta field-alignment(f: field) -> int {
  field-layout-alignment(field-layout-of(f))
}

inline-meta constructor-name(c: constructor) -> text {
  let Constructor(name, _, _) = c;
  name
}

inline-meta constructor-is-const-like(c: constructor) -> bool {
  let Constructor(_, is-const-like, _) = c;
  is-const-like
}

inline-meta constructor-fields(c: constructor) -> list(field) {
  let Constructor(_, _, fields) = c;
  fields
}

inline-meta constructor-field-count(c: constructor) -> int {
  length(constructor-fields(c))
}

inline-meta constructor-payload-end(c: constructor, start: int) -> int {
  fold-left(start, constructor-fields(c), (acc, !f) => {
    add-int(align-up(field-alignment(f), acc), field-storage-byte-size(f))
  })
}

inline-meta constructor-alignment(c: constructor) -> int {
  fold-left(1, constructor-fields(c), (acc, f) => {
    _larger(field-alignment(f), acc)
  })
}

inline-meta discriminant-width(constructors: list(constructor)) -> storage-width {
  let n = length(constructors);
  if le-int(n, 256) {
    Width8
  } else {
    if le-int(n, 65536) {
      Width16
    } else {
      Width32
    }
  }
}

inline-meta header-byte-size(!constructors: list(constructor)) -> int {
  if gt-int(length(constructors), 1) {
    storage-width-byte-size(discriminant-width(constructors))
  } else {
    0
  }
}

inline-meta algebraic-header-byte-size(constructors: list(constructor)) -> int {
  header-byte-size(constructors)
}

inline-meta load-at-width(width: storage-width, addr: 'pointer) -> 'int {
  match width {
  | Width8 =>
    quote {zext-int8-int(load-int8(unquote {addr}))}
  | Width16 =>
    quote {zext-int16-int(load-int16(unquote {addr}))}
  | Width32 =>
    quote {zext-int32-int(load-int32(unquote {addr}))}
  | Width64 =>
    quote {load-int(unquote {addr})}
  | Width-Pointer =>
    quote {cast-inline<pointer, int>(load-pointer(unquote {addr}))}
  }
}

inline-meta algebraic-discriminant<a>(!constructors: list(constructor), x: '&a) -> 'int {
  if gt-int(length(constructors), 1) {
    let width = discriminant-width(constructors);
    quote {
      let x-ptr = cast-inline<&a, pointer>(unquote {x});
      unquote {load-at-width(width, quote {x-ptr})}
    }
  } else {
    quote {0}
  }
}

inline-meta _constructor-switch-clauses<a>(
  constructors: list(constructor),
  cons-index: int,
  !on-hit: (constructor) -> 'a,
) -> list(pair(int, 'a)) {
  match constructors {
  | Nil =>
    Nil
  | Cons(c, rest) =>
    Cons(
      Pair(cons-index, on-hit(c)),
      _constructor-switch-clauses(rest, add-int(cons-index, 1), on-hit),
    )
  }
}

// Generates a runtime switch over the algebraic discriminant while traversing
// the constructor metadata.
inline-meta constructor-switch<a>(
  constructors: list(constructor),
  disc: 'int,
  fallback: 'a,
  on-hit: (constructor) -> 'a,
) -> 'a {
  let clauses = _constructor-switch-clauses(constructors, 0, on-hit);
  magic make-switch(disc, fallback, clauses)
}

inline-meta _enum-switch-clauses<a>(
  names: list(text),
  cons-index: int,
  !on-hit: (text) -> 'a,
) -> list(pair(int, 'a)) {
  match names {
  | Nil =>
    Nil
  | Cons(name, rest) =>
    Cons(
      Pair(cons-index, on-hit(name)),
      _enum-switch-clauses(rest, add-int(cons-index, 1), on-hit),
    )
  }
}

// Generates a runtime switch over an enum discriminant while traversing the
// constructor names at meta-time.
inline-meta enum-switch<a>(
  names: list(text),
  disc: 'int,
  fallback: 'a,
  on-hit: (text) -> 'a,
) -> 'a {
  let clauses = _enum-switch-clauses(names, 0, on-hit);
  magic make-switch(disc, fallback, clauses)
}

inline-meta is-algebraic(tv: type-value) -> bool {
  match tv {
  | Algebraic(_, _, _) =>
    True
  | _ =>
    False
  }
}

inline-meta algebraic-data-args(tv: type-value) -> ?list(type) {
  match tv {
  | Algebraic(_, data-args, _) =>
    Right(data-args)
  | _ =>
    Left(Unit)
  }
}

inline-meta algebraic-constructors(tv: type-value) -> ?list(constructor) {
  match tv {
  | Algebraic(_, _, constructors) =>
    Right(constructors)
  | _ =>
    Left(Unit)
  }
}

inline-meta data-arg-count(data-args: list(type)) -> int {
  length(data-args)
}

inline-meta fields-with-cursors(fields: list(field), cursor: int) -> list(pair(field, int)) {
  match fields {
  | Nil =>
    Nil
  | Cons(!f, rest) =>
    let start = align-up(field-alignment(f), cursor);
    Cons(Pair(f, start), fields-with-cursors(rest, add-int(start, field-storage-byte-size(f))))
  }
}

inline-meta constructor-fields-with-cursors(c: constructor, cursor: int) -> list(pair(field, int)) {
  fields-with-cursors(constructor-fields(c), cursor)
}

inline-meta payload-start(constructors: list(constructor), data-arg-num: int) -> int {
  let header = header-byte-size(constructors);
  if eq-int(data-arg-num, 0) {
    header
  } else {
    let width = pointer-byte-size();
    add-int(align-up(width, header), mul-int(width, data-arg-num))
  }
}

inline-meta algebraic-cell-alignment(!constructors: list(constructor), data-arg-num: int) -> int {
  let header-alignment = header-byte-size(constructors);
  let data-arg-alignment =
    if eq-int(data-arg-num, 0) {
      1
    } else {
      pointer-byte-size()
    };
  fold-left(_larger(_larger(header-alignment, data-arg-alignment), 1), constructors, (acc, c) => {
    _larger(constructor-alignment(c), acc)
  })
}

inline-meta algebraic-cell-byte-size(!constructors: list(constructor), data-arg-num: int) -> int {
  let start = payload-start(constructors, data-arg-num);
  let used =
    fold-left(start, constructors, (acc, c) => {
      _larger(constructor-payload-end(c, start), acc)
    });
  align-up(algebraic-cell-alignment(constructors, data-arg-num), used)
}

inline nth-field-pointer(offset: int, x: pointer) -> pointer {
  shift(x, offset)
}

inline-meta field-slot<a>(f: field, cursor: int, x: '&a) -> 'int {
  match field-layout-of(f) {
  | Direct(width) =>
    quote {
      let offset = unquote {promote {cursor}};
      let x-ptr = cast-inline<&a, pointer>(unquote {x});
      let field-ptr = nth-field-pointer(offset, x-ptr);
      unquote {load-at-width(width, quote {field-ptr})}
    }
  | Mixed(_) =>
    quote {
      let offset = unquote {promote {cursor}};
      let x-ptr = cast-inline<&a, pointer>(unquote {x});
      cast-inline<pointer, int>(nth-field-pointer(offset, x-ptr))
    }
  }
}

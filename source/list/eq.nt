import {
  this::bool {False, True, bool},
  this::eq {Eq, eq},
  this::list {Cons, Nil, list},
}

inline as-eq<a>(f: eq(a)) -> eq(list(a)) {
  let Eq{equal := !eq} = f;
  define equal(xs: &list(a), ys: &list(a)) -> bool {
    case xs, ys {
    | Nil, Nil =>
      True
    | Nil, Cons(_, _) =>
      False
    | Cons(_, _), Nil =>
      False
    | Cons(x, xs), Cons(y, ys) =>
      if eq(x, y) {
        equal(xs, ys)
      } else {
        False
      }
    }
  };
  Eq{equal}
}

define member<a>(e: &eq(a), xs: &list(a), value: &a) -> bool {
  case xs {
  | Nil =>
    False
  | Cons(y, ys) =>
    tie Eq{equal} = e;
    if equal(value, y) {
      True
    } else {
      member(e, ys, value)
    }
  }
}

define nub<a>(e: &eq(a), xs: list(a)) -> list(a) {
  define go(xs: list(a), acc: list(a)) -> list(a) {
    match xs {
    | Nil =>
      Nil
    | Cons(y, ys) =>
      let already-found-p on acc, !y = member(e, acc, y);
      if already-found-p {
        go(ys, acc)
      } else {
        Cons(y, go(ys, Cons(y, acc)))
      }
    }
  };
  go(xs, Nil)
}

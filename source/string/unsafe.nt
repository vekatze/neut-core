import {
  this::binary {binary},
  this::binary.unsafe {access-unchecked},
  this::pointer {shift},
  this::rune.unsafe {load-rune},
  this::string {string},
  this::string.pointer {get-content-pointer},
}

inline from-binary(t: binary) -> string {
  magic cast(binary, string, t)
}

inline drop(t: string, offset: int) -> string {
  let t = magic cast(string, binary, t);
  magic cast(binary, string, this::binary::drop(t, offset))
}

inline take(t: string, offset: int) -> string {
  let t = magic cast(string, binary, t);
  magic cast(binary, string, this::binary::take(t, offset))
}

inline slice(t: string, start: int, size: int) -> string {
  take(drop(t, start), size)
}

inline drop-N(t: &string, offset: int) -> string {
  let t = magic cast(&string, &binary, t);
  magic cast(binary, string, this::binary::drop-N(t, offset))
}

inline take-N(t: &string, offset: int) -> string {
  let t = magic cast(&string, &binary, t);
  magic cast(binary, string, this::binary::take-N(t, offset))
}

inline slice-N(t: &string, start: int, size: int) -> string {
  let t = magic cast(&string, &binary, t);
  magic cast(binary, string, this::binary::slice-N(t, start, size))
}

inline get-byte-unchecked(t: &string, index: int) -> int8 {
  access-unchecked(magic cast(&string, &binary, t), index)
}

inline get-rune-unchecked(t: &string, index: int) -> rune {
  load-rune(shift(get-content-pointer(t), index))
}

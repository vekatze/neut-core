import {
  ansi {command},
  binary.builder {binary-builder, make-binary-builder},
  string {string},
  string.unsafe {from-binary},
  unit {unit},
}

data string-builder {
| _String-Builder(binary-builder)
}

inline _to-binary-builder(b: string-builder) -> binary-builder {
  let _String-Builder(b) = b;
  b
}

inline _to-binary-builder-N(b: &string-builder) -> &binary-builder {
  tie _String-Builder(b) = b;
  b
}

define make-string-builder(size: int) -> string-builder {
  _String-Builder(make-binary-builder(size))
}

define extract(b: string-builder) -> string {
  from-binary(binary.builder.extract(_to-binary-builder(b)))
}

define append-int64-UTF8(b: &string-builder, x: int64) -> unit {
  binary.builder.append-int64-UTF8(_to-binary-builder-N(b), x)
}

define append-int32-UTF8(b: &string-builder, x: int32) -> unit {
  binary.builder.append-int32-UTF8(_to-binary-builder-N(b), x)
}

define append-int16-UTF8(b: &string-builder, x: int16) -> unit {
  binary.builder.append-int16-UTF8(_to-binary-builder-N(b), x)
}

define append-int8-UTF8(b: &string-builder, x: int8) -> unit {
  binary.builder.append-int8-UTF8(_to-binary-builder-N(b), x)
}

define append-float64-UTF8(b: &string-builder, x: float64) -> unit {
  binary.builder.append-float64-UTF8(_to-binary-builder-N(b), x)
}

define append-float32-UTF8(b: &string-builder, x: float32) -> unit {
  binary.builder.append-float32-UTF8(_to-binary-builder-N(b), x)
}

define append-float16-UTF8(b: &string-builder, x: float16) -> unit {
  binary.builder.append-float16-UTF8(_to-binary-builder-N(b), x)
}

define append-string(b: &string-builder, x: &string) -> unit {
  binary.builder.append-string(_to-binary-builder-N(b), x)
}

inline append-rune-UTF8(b: &string-builder, x: rune) -> unit {
  binary.builder.append-rune-UTF8(_to-binary-builder-N(b), x)
}

inline append-ansi(b: &string-builder, x: command) -> unit {
  binary.builder.append-ansi(_to-binary-builder-N(b), x)
}

rule-left String {
  inline-meta leaf(_: int) -> 'string-builder {
    quote {make-string-builder(64)}
  },
  inline-meta node-left(acc: 'string-builder, s: '&string) -> 'string-builder {
    quote {
      let b = unquote {acc};
      let _ on b = string.builder.append-string(b, unquote {s});
      b
    }
  },
  inline-meta root(acc: 'string-builder) -> 'string {
    quote {extract(unquote {acc})}
  },
}

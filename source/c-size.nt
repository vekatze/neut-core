import {
  this::bool {bool},
  this::c-ssize {C-SSize, c-ssize},
  this::c-word {c-word},
}

data c-size {
| C-Size(c-word)
}

inline to-c-size(x: int) -> c-size {
  C-Size(this::c-word::from-int(x))
}

inline from-c-size(x: c-size) -> int {
  let C-Size(x) = x;
  this::c-word::to-int-unsigned(x)
}

inline from-positive-ssize(x: c-ssize) -> c-size {
  let C-SSize(x) = x;
  C-Size(x)
}

inline add-c-size(x: c-size, y: c-size) -> c-size {
  to-c-size(add-int(from-c-size(x), from-c-size(y)))
}

inline mul-c-size(x: c-size, y: c-size) -> c-size {
  to-c-size(mul-int(from-c-size(x), from-c-size(y)))
}

inline eq-c-size(x: c-size, y: c-size) -> bool {
  eq-int(from-c-size(x), from-c-size(y))
}

inline ne-c-size(x: c-size, y: c-size) -> bool {
  ne-int(from-c-size(x), from-c-size(y))
}

inline lt-c-size(x: c-size, y: c-size) -> bool {
  ult-int(from-c-size(x), from-c-size(y))
}

inline le-c-size(x: c-size, y: c-size) -> bool {
  ule-int(from-c-size(x), from-c-size(y))
}

inline gt-c-size(x: c-size, y: c-size) -> bool {
  ugt-int(from-c-size(x), from-c-size(y))
}

inline ge-c-size(x: c-size, y: c-size) -> bool {
  uge-int(from-c-size(x), from-c-size(y))
}

import {
  binary,
  layer,
  list {List, for-each-N, list},
  show {Show, show},
  string {intercalate, join},
}

inline as-show<a>(s: show(a)) -> show(list(a)) {
  Show((xs) => {
    let Show{render} = s;
    let ys = for-each-N(xs, render);
    join(List::[*"[", intercalate(ys, *", "), *"]"])
  })
}

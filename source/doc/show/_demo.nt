import {
  ansi {Blue, Yellow},
  binary,
  doc {Group, Nest, ansi-fg, ansi-reset, atom, break, join},
  doc.show {show-doc},
  layer,
  string,
  string.io {print-line},
  unit {Unit, unit},
}

define zen() -> unit {
  pin item =
    Group(join::[
      ansi-fg(Blue),
      atom(*"begin"),
      ansi-reset,
      Nest(2, join::[
        break(" "),
        Group(
          join::[
            ansi-fg(Yellow),
            atom(*"print;"),
            ansi-reset,
            break(" "),
            atom(*"test;"),
            break(" "),
            atom(*"stmt;"),
          ],
        ),
      ]),
      break(" "),
      ansi-fg(Blue),
      atom(*"end"),
      ansi-reset,
    ]);
  pin item = show-doc(item, 10);
  print-line(item);
  Unit
}

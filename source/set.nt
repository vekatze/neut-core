import {
  bool {False, True, bool},
  dictionary {dictionary},
  either {Left, Right},
  list {Cons, Nil, fold-left, list},
  ord {ord},
  pair {Pair, pair},
  unit {Unit, unit},
}

data set(a) {
| _Set(dictionary(a, unit))
}

constant empty<a>: set(a) {
  _Set(dictionary.empty)
}

define size<a>(s: &set(a)) -> int {
  tie _Set(s) = s;
  dictionary.size(s)
}

define is-empty<a>(s: &set(a)) -> bool {
  eq-int(size(s), 0)
}

define singleton<a>(x: a) -> set(a) {
  _Set(dictionary.singleton(x, Unit))
}

define insert<a>(o: &ord(a), s: set(a), x: a) -> set(a) {
  let _Set(s) = s;
  _Set(dictionary.insert(o, s, x, Unit))
}

define delete<a>(o: &ord(a), s: set(a), x: a) -> set(a) {
  let _Set(s) = s;
  _Set(dictionary.delete(o, s, x))
}

define member<a>(o: &ord(a), s: &set(a), x: &a) -> bool {
  tie _Set(s) = s;
  match dictionary.lookup(o, s, x) {
  | Right(_) =>
    True
  | Left(_) =>
    False
  }
}

define from-list<a>(o: &ord(a), xs: list(a)) -> set(a) {
  fold-left(empty, xs, (acc, x) => {
    insert(o, acc, x)
  })
}

define _to-list-aux<a>(kvs: list(pair(a, unit)), acc: list(a)) -> list(a) {
  match kvs {
  | Nil =>
    acc
  | Cons(Pair(x, _), rest) =>
    Cons(x, _to-list-aux(rest, acc))
  }
}

define to-list<a>(s: set(a)) -> list(a) {
  let _Set(s) = s;
  _to-list-aux(dictionary.to-list(s), Nil)
}

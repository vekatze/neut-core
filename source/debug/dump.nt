import {
  this::binary,
  this::bool {True, bool},
  this::doc.show {show-doc},
  this::show.generic {to-doc},
  this::string,
  this::string.io {print},
  this::unit {unit},
}

inline-meta vet<a>(x: '&a)[
  ribbon-length: 'int := quote {50},
  enable-ansi: 'bool := quote {True},
] -> 'unit {
  quote {
    pin tmp = unquote {to-doc(x, enable-ansi)};
    pin item = show-doc(tmp, unquote {ribbon-length});
    print(item);
    print("\n");
  }
}

inline-meta trace<a>(x: 'a) -> 'a {
  quote {
    let x = unquote {x};
    let _ on x = unquote {vet(quote {x})};
    x
  }
}

import {
  binary,
  either {Left, Right, either},
  list {List},
  show {Show, show},
  string {format},
}

inline as-show<a, b>(s1: show(a), s2: show(b)) -> show(either(a, b)) {
  Show((val) => {
    case val {
    | Left(x) =>
      let Show{render} = s1;
      format("Left({})", List::[render(x)])
    | Right(y) =>
      let Show{render} = s2;
      format("Right({})", List::[render(y)])
    }
  })
}

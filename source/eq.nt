import {
  bool {False, True, bool},
  ord {Ord, ord},
  ordering {EQ},
}

data eq(a) {
| Eq(
    equal: (&a, &a) -> bool,
  )
}

inline from-ord<a>(o: ord(a)) -> eq(a) {
  Eq{
    equal := {
      (x, y) => {
        let Ord{compare} = o;
        match compare(x, y) {
        | EQ =>
          True
        | _ =>
          False
        }
      }
    },
  }
}

import {
  binary,
  bool {bool},
  file.buffer {buffer},
  string,
  string.io.buffer {write, write-line},
  system {system},
  unit {unit},
}

define write-bool(k: &buffer, x: bool) ->> system(unit) {
  if x {
    write(k, "True")
  } else {
    write(k, "False")
  }
}

define write-bool-line(k: &buffer, x: bool) ->> system(unit) {
  if x {
    write-line(k, "True")
  } else {
    write-line(k, "False")
  }
}

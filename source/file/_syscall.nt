import {
  this::c-int {C-Int, c-int},
  this::c-offset {C-Offset, c-offset},
}

foreign {
  close(c-int) -> c-int,
  neut_core_v0_56_lseek(c-int, int, c-int) -> int,
  dup2(c-int, c-int) -> c-int,
}

define close(fd: c-int) -> c-int {
  magic external close(fd)
}

define lseek(fd: c-int, offset: c-offset, origin: c-int) -> c-offset {
  let C-Offset(offset) = offset;
  C-Offset(magic external neut_core_v0_56_lseek(fd, offset, origin))
}

define dup2(fd1: c-int, fd2: c-int) -> c-int {
  introspect target-os {
  | wasi =>
    let _ = fd1;
    let _ = fd2;
    C-Int(-1)
  | default =>
    magic external dup2(fd1, fd2)
  }
}

import {
  binary,
  list {List},
  path.entity.dirent {Dirent, dirent},
  path.entity.dtype {DT_DIR},
  string {format, string},
}

define show-dirent(e: dirent) -> string {
  let Dirent{kind, name} = e;
  match kind {
  | DT_DIR =>
    format("{}/", List::[name])
  | _ =>
    format("{}", List::[name])
  }
}

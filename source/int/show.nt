import {
  this::binary {allocate},
  this::binary.pointer {get-content-pointer},
  this::bool {False, True, bool},
  this::memory.unsafe {store-int8},
  this::pointer {shift},
  this::show {Show, show},
  this::string {string},
  this::string.unsafe {from-binary},
  this::unit {Unit, unit},
}

define _digit-count(magnitude: int, count: int) -> int {
  let rest = udiv-int(magnitude, 10);
  if eq-int(rest, 0) {
    count
  } else {
    _digit-count(rest, add-int(count, 1))
  }
}

define _write-digits(last: pointer, magnitude: int) -> unit {
  store-int8(trunc-int64-int8(add-int(48, urem-int(magnitude, 10))), last);
  let rest = udiv-int(magnitude, 10);
  if eq-int(rest, 0) {
    Unit
  } else {
    _write-digits(shift(last, -1), rest)
  }
}

define _show(negative: bool, magnitude: int) -> string {
  let sign =
    if negative {
      1
    } else {
      0
    };
  let size = add-int(sign, _digit-count(magnitude, 1));
  let content = allocate(size);
  let _ on content = {
    let head = get-content-pointer(content);
    if negative {
      store-int8(45, head)
    } else {
      Unit
    };
    _write-digits(shift(head, sub-int(size, 1)), magnitude)
  };
  from-binary(content)
}

define _show-signed(x: int) -> string {
  if lt-int(x, 0) {
    _show(True, sub-int(0, x))
  } else {
    _show(False, x)
  }
}

constant as-show: show(int) {
  Show((x) => {
    _show-signed(*x)
  })
}

define show-int(x: int) -> string {
  _show-signed(x)
}

define show-int64(x: int) -> string {
  _show-signed(x)
}

define show-uint(x: int) -> string {
  _show(False, x)
}

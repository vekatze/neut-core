import {
  this::c-size {to-c-size},
  this::memory {malloc},
  this::memory.unsafe {store-address-int, store-pointer},
  this::pointer {shift},
  this::show {Show, show},
  this::string {string},
  this::unit,
}

foreign {
  neut_core_v0_57_build_float_buf(pointer, int, float, int) -> int,
  neut_core_v0_57_build_float32_buf(pointer, int, float32, int) -> int,
  neut_core_v0_57_build_float64_buf(pointer, int, float, int) -> int,
}

define show-float(x: float) -> string {
  let size = 32;
  let add-newline = 0;
  let word-size = this::pointer::size;
  let u2 = mul-int(word-size, 2);
  let u3 = mul-int(word-size, 3);
  let string-ptr = malloc(to-c-size(add-int(size, u3)));
  let buffer-ptr = shift(string-ptr, u3);
  let len = magic external neut_core_v0_57_build_float_buf(buffer-ptr, size, x, add-newline);
  store-address-int(0, string-ptr);
  store-address-int(len, shift(string-ptr, word-size));
  store-pointer(buffer-ptr, shift(string-ptr, u2));
  magic cast(pointer, string, string-ptr)
}

define show-float64(x: float) -> string {
  let size = 32;
  let add-newline = 0;
  let word-size = this::pointer::size;
  let u2 = mul-int(word-size, 2);
  let u3 = mul-int(word-size, 3);
  let string-ptr = malloc(to-c-size(add-int(size, u3)));
  let buffer-ptr = shift(string-ptr, u3);
  let len = magic external neut_core_v0_57_build_float64_buf(buffer-ptr, size, x, add-newline);
  store-address-int(0, string-ptr);
  store-address-int(len, shift(string-ptr, word-size));
  store-pointer(buffer-ptr, shift(string-ptr, u2));
  magic cast(pointer, string, string-ptr)
}

define show-float32(x: float32) -> string {
  let size = 32;
  let add-newline = 0;
  let word-size = this::pointer::size;
  let u2 = mul-int(word-size, 2);
  let u3 = mul-int(word-size, 3);
  let string-ptr = malloc(to-c-size(add-int(size, u3)));
  let buffer-ptr = shift(string-ptr, u3);
  let len = magic external neut_core_v0_57_build_float32_buf(buffer-ptr, size, x, add-newline);
  store-address-int(0, string-ptr);
  store-address-int(len, shift(string-ptr, word-size));
  store-pointer(buffer-ptr, shift(string-ptr, u2));
  magic cast(pointer, string, string-ptr)
}

constant as-show: show(float) {
  Show((x) => {
    show-float(*x)
  })
}

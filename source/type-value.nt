import {
  bool {bool},
  list {list},
}

data field-layout {
| Direct
| Mixed(slot-count: int)
}

data field {
| Field(
    name: text,
    field-type: type,
    layout: field-layout,
  )
}

data constructor {
| Constructor(text, bool, list(field))
}

data type-value {
| Opaque
| Type
| Function
| Algebraic(data-name: text, data-param-types: list(type), constructors: list(constructor))
| Noema(type)
| Enum(constructors: list(text))
| Int1
| Int2
| Int4
| Int8
| Int16
| Int32
| Int64
| Float16
| Float32
| Float64
| Pointer
| Null
| Rune
| Binary
| Vector(type)
| Array(type)
| Wrapper(type)
| Box-T(type)
}

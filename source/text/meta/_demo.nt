import {
  binary,
  bool {False},
  bool.meta {or},
  debug.meta {assert},
  either {Left, Right},
  int.io {print-int-line},
  list {Cons, Nil},
  pair {Pair},
  string,
  text.meta,
  unit {Unit, unit},
}

define-meta _assert-basic() -> 'unit {
  quote {
    unquote {assert("text.meta: is-empty\n", text.meta.is-empty(""))};
    unquote {assert("text.meta: eq-text\n", text.meta.eq-text("abc", "abc"))};
    unquote {assert("text.meta: ne-text\n", text.meta.ne-text("abc", "abd"))};
    unquote {assert("text.meta: singleton\n", text.meta.eq-text(text.meta.singleton(`x`), "x"))};
    unquote {assert("text.meta: append\n", text.meta.eq-text(text.meta.append("ab", "cd"), "abcd"))};
    Unit
  }
}

define-meta _assert-substrings() -> 'unit {
  let s = "abcdef";
  let Pair(prefix, suffix) = text.meta.split-at(s, 2);
  quote {
    unquote {assert("text.meta: length\n", eq-int(text.meta.length(s), 6))};
    unquote {assert("text.meta: take\n", text.meta.eq-text(text.meta.take(s, 3), "abc"))};
    unquote {assert("text.meta: drop\n", text.meta.eq-text(text.meta.drop(s, 3), "def"))};
    unquote {assert("text.meta: slice\n", text.meta.eq-text(text.meta.slice(s, 2, 3), "cde"))};
    unquote {assert("text.meta: split-at prefix\n", text.meta.eq-text(prefix, "ab"))};
    unquote {assert("text.meta: split-at suffix\n", text.meta.eq-text(suffix, "cdef"))};
    unquote {assert("text.meta: take-end\n", text.meta.eq-text(text.meta.take-end(s, 2), "ef"))};
    unquote {assert("text.meta: drop-end\n", text.meta.eq-text(text.meta.drop-end(s, 2), "abcd"))};
    Unit
  }
}

define-meta _assert-search() -> 'unit {
  let s = "abcあdef";
  quote {
    unquote {assert("text.meta: eq-prefix\n", text.meta.eq-prefix(s, "abc"))};
    unquote {assert("text.meta: eq-suffix\n", text.meta.eq-suffix(s, "def"))};
    unquote {assert("text.meta: eq-infix\n", text.meta.eq-infix(s, "cあd"))};
    unquote {assert("text.meta: find-text\n", text.meta.find-text(s, "あd"))};
    unquote {assert("text.meta: ne-text shorter\n", text.meta.ne-text(s, "abc"))};
    Unit
  }
}

define-meta _assert-fold-and-predicates() -> 'unit {
  let s = "aaabc";
  let is-a =
    (r) => {
      eq-rune(r, `a`)
    };
  let is-ascii-prefix =
    (r) => {
      or(eq-rune(r, `a`), or(eq-rune(r, `b`), eq-rune(r, `c`)))
    };
  let count =
    text.meta.fold(0, s, (acc, _) => {
      add-int(acc, 1)
    });
  let found =
    text.meta.find(s, (r) => {
      eq-rune(r, `b`)
    });
  match found {
  | Right(index) =>
    quote {
      unquote {assert("text.meta: fold\n", eq-int(count, 5))};
      unquote {assert("text.meta: drop-while\n", text.meta.eq-text(text.meta.drop-while(s, is-a), "bc"))};
      unquote {assert("text.meta: all\n", text.meta.all(s, is-ascii-prefix))};
      unquote {
        assert("text.meta: any\n", text.meta.any(s, (r) => {
          eq-rune(r, `b`)
        }))
      };
      unquote {assert("text.meta: find\n", eq-int(index, 3))};
      Unit
    }
  | Left(_) =>
    assert("text.meta: find\n", False)
  }
}

define-meta _assert-list-combinators() -> 'unit {
  let !xs = Cons("ab", Cons("cd", Cons("ef", Nil)));
  let joined = text.meta.concat(xs);
  let separated = text.meta.intercalate(xs, "-");
  quote {
    unquote {assert("text.meta: concat\n", text.meta.eq-text(joined, "abcdef"))};
    unquote {assert("text.meta: intercalate\n", text.meta.eq-text(separated, "ab-cd-ef"))};
    Unit
  }
}

define-meta _assert-strip() -> 'unit {
  quote {
    unquote {assert("text.meta: strip-prefix hit\n", text.meta.eq-text(text.meta.strip-prefix("abc", "abcdef"), "def"))};
    unquote {assert("text.meta: strip-prefix miss\n", text.meta.eq-text(text.meta.strip-prefix("xxx", "abcdef"), "abcdef"))};
    unquote {assert("text.meta: strip-suffix hit\n", text.meta.eq-text(text.meta.strip-suffix("def", "abcdef"), "abc"))};
    unquote {assert("text.meta: strip-suffix miss\n", text.meta.eq-text(text.meta.strip-suffix("xxx", "abcdef"), "abcdef"))};
    Unit
  }
}

define zen() -> unit {
  _assert-basic::();
  _assert-substrings::();
  _assert-search::();
  _assert-fold-and-predicates::();
  _assert-list-combinators::();
  _assert-strip::();
  print-int-line(1);
  Unit
}

import {
  binary,
  either {Left, Right},
  file.descriptor {stdin, stdout},
  string,
  string.io {print, print-line, read, write},
  system {get-error-message},
  unit {unit},
}

define zen() -> unit {
  // print("hey\n");
  // Unit
  let _ = write(stdout, "hello.\n");
  let value = read(stdin, 10);
  match value {
  | Right(sample) =>
    pin sample = sample;
    print-line(sample);
    print("success\n")
  | Left(e) =>
    pin string = get-error-message(e);
    print(string);
    print("\n")
  }
}

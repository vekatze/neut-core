import {
  binary,
  binary.io.buffer {write-binary},
  either,
  file.buffer {flush, make-buffer},
  file.descriptor {stdout},
  string {to-binary},
  system {system},
  unit {Unit, unit},
}

define zen() -> unit {
  let !k = make-buffer(stdout, 0);
  let _ = k;
  let _ = k;
  pin k = k;
  let _: system(unit) = {
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    try _ = write-binary(k, to-binary("hello\n"));
    flush(k)
  };
  Unit
}

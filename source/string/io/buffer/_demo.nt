import {
  binary,
  either {Right},
  file.buffer {flush, make-buffer},
  file.descriptor {stdout},
  string,
  string.io.buffer {write-line},
  system {system},
  unit {Unit, unit},
}

define zen() -> unit {
  let !k = make-buffer(stdout, 4096);
  pin k = k;
  let _: system(unit) = {
    try _ = write-line(k, "hello!");
    try _ = write-line(k, "hello!");
    try _ = flush(k);
    Right(Unit)
  };
  Unit
}

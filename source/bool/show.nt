import {
  this::binary,
  this::bool {bool},
  this::layer,
  this::show {* as s},
  this::string {string},
}

constant as-show: s.show(bool) {
  s.Show((b) => {
    if *b {
      *"True"
    } else {
      *"False"
    }
  })
}

define show(b: bool) -> string {
  let s.Show{render} = as-show;
  pin b = b;
  render(b)
}

define show-bool(b: bool) -> string {
  show(b)
}

import {
  this::bool,
  this::c-size {to-c-size},
  this::layer {axiom-T},
  this::memory {malloc},
  this::memory.unsafe {free, load-int, store-int},
  this::pair {Pair, pair},
  this::pointer {is-null-pointer, shift},
  this::unit {Unit, unit},
  this::unsafe {cast-inline},
  this::word,
}

constant _cell-size: int {
  mul-int(2, this::word::size)
}

resource _cell {
  (ch: pointer, flag: int) => {
    let a = load-int(shift(ch, this::word::size));
    magic call-type(a, 0, load-int(ch), add-int(0, 1));
    if eq-int(flag, 1) {
      free(ch)
    } else {
      Unit
    }
  },
  (ch: pointer, dest: pointer) => {
    let u = this::word::size;
    unpack-type a = cast-inline<int, type>(load-int(shift(ch, u)));
    let val: &a = cast-inline<int, &a>(load-int(ch));
    let u = this::word::size;
    let ptr =
      if is-null-pointer(dest) {
        malloc(to-c-size(_cell-size))
      } else {
        dest
      };
    store-int(cast-inline<a, int>(*val), ptr);
    store-int(cast-inline<type, int>(pack-type {a}), shift(ptr, u));
    ptr
  },
  _cell-size,
}

data cell(_: type) {
| _Cell(_cell)
}

inline make-cell<a>(initial-value: ^a) -> cell(a) {
  let u = this::word::size;
  let ptr = malloc(to-c-size(_cell-size));
  store-int(cast-inline<a, int>(axiom-T(initial-value)), ptr);
  store-int(cast-inline<type, int>(pack-type {a}), shift(ptr, u));
  _Cell(magic cast(pointer, _cell, ptr))
}

inline modify<a, b>(r: &cell(a), f: (^a) -> pair(^a, b)) -> b {
  let r = cast-inline<&cell(a), pointer>(r);
  let orig-val = cast-inline<int, ^a>(load-int(r));
  let Pair(new-val, result) = f(orig-val);
  store-int(cast-inline<^a, int>(new-val), r);
  result
}

inline mutate<a>(r: &cell(a), f: (^a) -> ^a) -> unit {
  modify(r, (x) => {
    Pair(f(x), Unit)
  })
}

inline borrow<a, b>(r: &cell(a), f: (&a) -> ^b) -> b {
  let r = cast-inline<&cell(a), pointer>(r);
  let orig-val = cast-inline<int, &a>(load-int(r));
  letbox-T result = f(orig-val);
  result
}

inline clone<a>(r: &cell(a)) -> a {
  borrow(r, (v) => {
    box v {v}
  })
}

inline extract<a>(c: cell(a)) -> ^a {
  letbox-T result on c = {
    let r = cast-inline<&cell(a), pointer>(c);
    cast-inline<int, ^^a>(load-int(r))
  };
  free(cast-inline<cell(a), pointer>(c));
  result
}

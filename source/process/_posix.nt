require {
  subprocess,
}

import {
  this::c-int {c-int},
  this::c-pid {c-pid},
  this::c-size {c-size},
}

foreign {
  neut_core_v0_57_spawn(pointer, pointer, pointer, c-int, c-int, c-int, c-int, pointer, pointer) -> c-int,
  neut_core_v0_57_send_signal(c-pid, c-int, c-int) -> c-int,
  getpgrp() -> c-pid,
  neut_core_v0_57_write_until_closed(c-int, pointer, c-size) -> c-int,
  waitpid(c-pid, pointer, c-int) -> c-pid,
  neut_core_v0_57_wifexited(c-int) -> c-int,
  neut_core_v0_57_wifsignaled(c-int) -> c-int,
  neut_core_v0_57_wifstopped(c-int) -> c-int,
  neut_core_v0_57_wexitstatus(c-int) -> c-int,
  neut_core_v0_57_wtermsig(c-int) -> c-int,
  neut_core_v0_57_wcoredump(c-int) -> c-int,
  neut_core_v0_57_wstopsig(c-int) -> c-int,
}

define spawn(
  file: pointer,
  argv: pointer,
  cwd: pointer,
  input-mode: c-int,
  output-mode: c-int,
  error-output-mode: c-int,
  new-group: c-int,
  pid: pointer,
  descriptors: pointer,
) -> c-int {
  magic external neut_core_v0_57_spawn(file, argv, cwd, input-mode, output-mode, error-output-mode, new-group, pid, descriptors)
}

define send-signal(target: c-pid, signal-kind: c-int, to-group: c-int) -> c-int {
  magic external neut_core_v0_57_send_signal(target, signal-kind, to-group)
}

define get-process-group() -> c-pid {
  magic external getpgrp()
}

define write-until-closed(fd: c-int, content: pointer, size: c-size) -> c-int {
  magic external neut_core_v0_57_write_until_closed(fd, content, size)
}

define waitpid(pid: c-pid, status-ptr: pointer, option: c-int) -> c-pid {
  magic external waitpid(pid, status-ptr, option)
}

define wifexited(stat: c-int) -> c-int {
  magic external neut_core_v0_57_wifexited(stat)
}

define wifsignaled(stat: c-int) -> c-int {
  magic external neut_core_v0_57_wifsignaled(stat)

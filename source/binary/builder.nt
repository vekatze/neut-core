import {
  this::ansi {
    Background,
    Backward,
    Black,
    Blue,
    Bold,
    Color,
    Color-16,
    Color-256,
    Color-RGB,
    Cyan,
    Down,
    Down-Start,
    Dull,
    Erase,
    Faint,
    Foreground,
    Forward,
    From-Cursor,
    Green,
    Italic,
    Line,
    Magenta,
    Move-Cursor,
    Normal,
    Red,
    Screen,
    Set-Style,
    To,
    To-Column,
    To-Cursor,
    Underline,
    Up,
    Up-Start,
    Vivid,
    White,
    Whole,
    Yellow,
    command,
  },
  this::binary {allocate, binary, take},
  this::binary.pointer {get-content-pointer},
  this::bool,
  this::c-int {c-int, from-c-int},
  this::c-size {C-Size, c-size},
  this::cell {cell, make-cell, mutate},
  this::control {discard},
  this::int {max-int},
  this::layer {axiom-T},
  this::memory.unsafe {memcpy, store-float, store-int, store-int16, store-int32, store-int8},
  this::pointer {null-pointer, shift},
  this::rune {size, to-int32},
  this::rune.unsafe {store-rune},
  this::string {string},
  this::string.pointer,
  this::unit {Unit, unit},
}

foreign {
  snprintf(pointer, c-size, pointer) -> c-int,
  sprintf(pointer, pointer) -> c-int,
}

data _binary-builder {
| _Binary-Builder(
    cursor: int,
    content: binary,
  )
}

inline _prepare-state(b: +_binary-builder, fragment-size: int) -> +_binary-builder {
  let _Binary-Builder{cursor, content} = axiom-T(b);
  let current-size on content = this::binary::length(content);
  if gt-int(add-int(cursor, fragment-size), current-size) {
    let required-size = add-int(cursor, fragment-size);
    let new-content = allocate(max-int(mul-int(current-size, 2), max-int(required-size, 1)));
    let content-ptr on content = get-content-pointer(content);
    let new-content-ptr on new-content = get-content-pointer(new-content);
    memcpy(new-content-ptr, content-ptr, cursor);
    discard(content);
    lift {_Binary-Builder(cursor, new-content)}
  } else {
    lift {_Binary-Builder(cursor, content)}
  }
}

inline _append-with-reserve(
  b: +_binary-builder,
  reserve-size: int,
  fragment-size: int,
  write: (pointer) -> unit,
) -> +_binary-builder {
  let _Binary-Builder{cursor, content} = axiom-T(_prepare-state(b, reserve-size));
  let content-head-ptr on content = shift(get-content-pointer(content), cursor);
  write(content-head-ptr);
  lift {_Binary-Builder{cursor := add-int(cursor, fragment-size), content}}
}

inline _append(
  b: +_binary-builder,
  fragment-size: int,
  write: (pointer) -> unit,
) -> +_binary-builder {
  _append-with-reserve(b, fragment-size, fragment-size, write)
}

inline _append-int64(b: +_binary-builder, x: int) -> +_binary-builder {
  _append(b, 8, (ptr) => {
    store-int(x, ptr)
  })
}

inline _append-int64-UTF8(b: +_binary-builder, x: int64) -> +_binary-builder {
  let fmt = this::string.pointer::get-content-pointer("%ld\0");
  let fragment-size = from-c-int(magic external snprintf(null-pointer, C-Size(0), fmt)(x: int64));
  _append-with-reserve(b, add-int(fragment-size, 1), fragment-size, (ptr) => {
    let _ = magic external sprintf(ptr, fmt)(x: int64);
    Unit
  })
}

inline _append-int32(b: +_binary-builder, x: int32) -> +_binary-builder {
  _append(b, 4, (ptr) => {
    store-int32(x, ptr)
  })
}

inline _append-int16(b: +_binary-builder, x: int16) -> +_binary-builder {
  _append(b, 2, (ptr) => {
    store-int16(x, ptr)
  })
}

inline _append-int8(b: +_binary-builder, x: int8) -> +_binary-builder {
  _append(b, 1, (ptr) => {
    store-int8(x, ptr)
  })
}

inline _append-float64(b: +_binary-builder, x: float) -> +_binary-builder {
  _append(b, 8, (ptr) => {
    store-float(x, ptr)
  })
}

inline _append-float64-UTF8(b: +_binary-builder, x: float64) -> +_binary-builder {
  let fmt = this::string.pointer::get-content-pointer("%lf\0");
  let fragment-size = from-c-int(magic external snprintf(null-pointer, C-Size(0), fmt)(x: float64));
  _append-with-reserve(b, add-int(fragment-size, 1), fragment-size, (ptr) => {
    let _ = magic external sprintf(ptr, fmt)(x: float64);
    Unit
  })
}

inline _append-float32(b: +_binary-builder, x: float32) -> +_binary-builder {
  _append(b, 4, (ptr) => {
    magic store(float32, x, ptr)
  })
}

inline _append-float16(b: +_binary-builder, x: float16) -> +_binary-builder {
  _append(b, 2, (ptr) => {
    magic store(float16, x, ptr)
  })
}

inline _append-binary(b: +_binary-builder, x: &binary) -> +_binary-builder {
  let x-ptr = get-content-pointer(x);
  let x-size = this::binary::length(x);
  _append(b, x-size, (ptr) => {
    memcpy(ptr, x-ptr, x-size)
  })
}

inline _append-string(b: +_binary-builder, x: &string) -> +_binary-builder {
  let x-ptr = this::string.pointer::get-content-pointer(x);
  let x-size = this::string::byte-length(x);
  _append(b, x-size, (ptr) => {
    memcpy(ptr, x-ptr, x-size)
  })
}

inline _append-rune-UTF8(b: +_binary-builder, x: rune) -> +_binary-builder {
  let rune-size = size(x);
  _append(b, rune-size, (ptr) => {
    let buffer-ptr = magic alloca(int32, 1);
    let _ = store-rune(x, buffer-ptr);
    memcpy(ptr, buffer-ptr, rune-size)
  })
}

inline _append-ansi-offset(
  b: +_binary-builder,
  offset: int,
  suffix: &string,
) -> +_binary-builder {
  let b = _append-string(b, "\u{1B}[");
  let b = _append-int64-UTF8(b, offset);
  _append-string(b, suffix)
}

inline _append-ansi(b: +_binary-builder, c: command) -> +_binary-builder {
  match c {
  | Set-Style(style) =>
    match style {
    | Normal =>
      _append-string(b, "\u{1B}[0m")
    | Bold =>
      _append-string(b, "\u{1B}[1m")
    | Faint =>
      _append-string(b, "\u{1B}[2m")
    | Italic =>
      _append-string(b, "\u{1B}[3m")
    | Underline =>
      _append-string(b, "\u{1B}[4m")
    | Color(color-layer, color) =>
      match color-layer {
      | Foreground =>
        match color {
        | Color-16(color-intensity, color) =>
          match color-intensity {
          | Dull =>
            match color {
            | Black =>
              _append-string(b, "\u{1B}[30m")
            | Red =>
              _append-string(b, "\u{1B}[31m")
            | Green =>
              _append-string(b, "\u{1B}[32m")
            | Yellow =>
              _append-string(b, "\u{1B}[33m")
            | Blue =>
              _append-string(b, "\u{1B}[34m")
            | Magenta =>
              _append-string(b, "\u{1B}[35m")
            | Cyan =>
              _append-string(b, "\u{1B}[36m")
            | White =>
              _append-string(b, "\u{1B}[37m")
            }
          | Vivid =>
            match color {
            | Black =>
              _append-string(b, "\u{1B}[90m")
            | Red =>
              _append-string(b, "\u{1B}[91m")
            | Green =>
              _append-string(b, "\u{1B}[92m")
            | Yellow =>
              _append-string(b, "\u{1B}[93m")
            | Blue =>
              _append-string(b, "\u{1B}[94m")
            | Magenta =>
              _append-string(b, "\u{1B}[95m")
            | Cyan =>
              _append-string(b, "\u{1B}[96m")
            | White =>
              _append-string(b, "\u{1B}[97m")
            }
          }
        | Color-256(value) =>
          let b = _append-string(b, "\u{1B}[38;5;");
          let b = _append-int64-UTF8(b, zext-int8-int(value));
          _append-string(b, "m")
        | Color-RGB(r, g, blue) =>
          let b = _append-string(b, "\u{1B}[38;2;");
          let b = _append-int64-UTF8(b, zext-int8-int(r));
          let b = _append-string(b, ";");
          let b = _append-int64-UTF8(b, zext-int8-int(g));
          let b = _append-string(b, ";");
          let b = _append-int64-UTF8(b, zext-int8-int(blue));
          _append-string(b, "m")
        }
      | Background =>
        match color {
        | Color-16(color-intensity, color) =>
          match color-intensity {
          | Dull =>
            match color {
            | Black =>
              _append-string(b, "\u{1B}[40m")
            | Red =>
              _append-string(b, "\u{1B}[41m")
            | Green =>
              _append-string(b, "\u{1B}[42m")
            | Yellow =>
              _append-string(b, "\u{1B}[43m")
            | Blue =>
              _append-string(b, "\u{1B}[44m")
            | Magenta =>
              _append-string(b, "\u{1B}[45m")
            | Cyan =>
              _append-string(b, "\u{1B}[46m")
            | White =>
              _append-string(b, "\u{1B}[47m")
            }
          | Vivid =>
            match color {
            | Black =>
              _append-string(b, "\u{1B}[100m")
            | Red =>
              _append-string(b, "\u{1B}[101m")
            | Green =>
              _append-string(b, "\u{1B}[102m")
            | Yellow =>
              _append-string(b, "\u{1B}[103m")
            | Blue =>
              _append-string(b, "\u{1B}[104m")
            | Magenta =>
              _append-string(b, "\u{1B}[105m")
            | Cyan =>
              _append-string(b, "\u{1B}[106m")
            | White =>
              _append-string(b, "\u{1B}[107m")
            }
          }
        | Color-256(value) =>
          let b = _append-string(b, "\u{1B}[48;5;");
          let b = _append-int64-UTF8(b, zext-int8-int(value));
          _append-string(b, "m")
        | Color-RGB(r, g, blue) =>
          let b = _append-string(b, "\u{1B}[48;2;");
          let b = _append-int64-UTF8(b, zext-int8-int(r));
          let b = _append-string(b, ";");
          let b = _append-int64-UTF8(b, zext-int8-int(g));
          let b = _append-string(b, ";");
          let b = _append-int64-UTF8(b, zext-int8-int(blue));
          _append-string(b, "m")
        }
      }
    }
  | Move-Cursor(movement) =>
    match movement {
    | Up(offset) =>
      _append-ansi-offset(b, offset, "A")
    | Down(offset) =>
      _append-ansi-offset(b, offset, "B")
    | Forward(offset) =>
      _append-ansi-offset(b, offset, "C")
    | Backward(offset) =>
      _append-ansi-offset(b, offset, "D")
    | Up-Start(offset) =>
      _append-ansi-offset(b, offset, "E")
    | Down-Start(offset) =>
      _append-ansi-offset(b, offset, "F")
    | To-Column(column) =>
      _append-ansi-offset(b, column, "G")
    | To(x, y) =>
      let b = _append-string(b, "\u{1B}[");
      let b = _append-int64-UTF8(b, x);
      let b = _append-string(b, ";");
      let b = _append-int64-UTF8(b, y);
      _append-string(b, "H")
    }
  | Erase(space, span) =>
    match space {
    | Line =>
      match span {
      | From-Cursor =>
        _append-string(b, "\u{1B}[0K")
      | To-Cursor =>
        _append-string(b, "\u{1B}[1K")
      | Whole =>
        _append-string(b, "\u{1B}[2K")
      }
    | Screen =>
      match span {
      | From-Cursor =>
        _append-string(b, "\u{1B}[0J")
      | To-Cursor =>
        _append-string(b, "\u{1B}[1J")
      | Whole =>
        _append-string(b, "\u{1B}[2J")
      }
    }
  }
}

data binary-builder {
| _Binary-Builder-Ref(cell(_binary-builder))
}

inline _to-cell(b: binary-builder) -> cell(_binary-builder) {
  let _Binary-Builder-Ref(b) = b;
  b
}

inline _to-cell-N(b: &binary-builder) -> &cell(_binary-builder) {
  tie _Binary-Builder-Ref(b) = b;
  b
}

define extract(b: binary-builder) -> binary {
  let _Binary-Builder{cursor, content} = axiom-T(this::cell::extract(_to-cell(b)));
  take(content, cursor)
}

define make-binary-builder(size: int) -> binary-builder {
  _Binary-Builder-Ref(
    make-cell(
      lift {
        _Binary-Builder{
          cursor := 0,
          content := allocate(size),
        }
      },
    ),
  )
}

define append-int64(b: &binary-builder, x: int) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-int64(b, x)
  })
}

define append-int64-UTF8(b: &binary-builder, x: int64) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-int64-UTF8(b, x)
  })
}

define append-int32(b: &binary-builder, x: int32) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-int32(b, x)
  })
}

define append-int32-UTF8(b: &binary-builder, x: int32) -> unit {
  append-int64-UTF8(b, sext-int32-int64(x))
}

define append-int16(b: &binary-builder, x: int16) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-int16(b, x)
  })
}

define append-int16-UTF8(b: &binary-builder, x: int16) -> unit {
  append-int64-UTF8(b, sext-int16-int64(x))
}

define append-int8(b: &binary-builder, x: int8) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-int8(b, x)
  })
}

define append-int8-UTF8(b: &binary-builder, x: int8) -> unit {
  append-int64-UTF8(b, sext-int8-int64(x))
}

define append-float64(b: &binary-builder, x: float) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-float64(b, x)
  })
}

define append-float64-UTF8(b: &binary-builder, x: float64) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-float64-UTF8(b, x)
  })
}

define append-float32(b: &binary-builder, x: float32) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-float32(b, x)
  })
}

define append-float32-UTF8(b: &binary-builder, x: float32) -> unit {
  append-float64-UTF8(b, fpext-float32-float64(x))
}

define append-float16(b: &binary-builder, x: float16) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-float16(b, x)
  })
}

define append-float16-UTF8(b: &binary-builder, x: float16) -> unit {
  append-float64-UTF8(b, fpext-float16-float64(x))
}

define append-binary(b: &binary-builder, x: &binary) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-binary(b, x)
  })
}

define append-string(b: &binary-builder, x: &string) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-string(b, x)
  })
}

define append-rune(b: &binary-builder, x: rune) -> unit {
  append-int32(b, to-int32(x));
}

define append-rune-UTF8(b: &binary-builder, x: rune) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-rune-UTF8(b, x)
  })
}

inline append-ansi(b: &binary-builder, c: command) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append-ansi(b, c)
  })
}

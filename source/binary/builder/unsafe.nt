import {
  this::binary.builder {
    _append,
    _to-cell-N,
    binary-builder,
  },
  this::cell {mutate},
  this::memory.unsafe {memcpy},
  this::unit {unit},
}

define append-chunk(b: &binary-builder, ptr: pointer, size: int) -> unit {
  mutate(_to-cell-N(b), (b) => {
    _append(b, size, (dest) => {
      memcpy(dest, ptr, size)
    })
  })
}

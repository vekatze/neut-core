import {
  binary,
  bool {True, bool},
  box,
  debug.dump {vet},
  either {Left, either},
  list {list},
  pair {Pair, pair},
  string {string},
  string.io {print-line},
  unit {Unit, unit},
  vector {vector},
}

define zen() -> unit {
  pin xs: vector(pair(&string, +string)) = vector.Vector[Pair("a", box {*"b"}), Pair("c", box {*"d"})];
  print-line("before");
  pin k: either(bool, list(float)) = Left(True);
  vet::(k);
  vet::(xs);
  print-line("after");
  Unit
}

import {
  binary,
  layer,
  rc {borrow, new},
  string,
  string.io {print, print-line},
  unit {Unit, unit},
}

define zen() -> unit {
  let value = new(*"hello");
  let !value = value;
  let alias = value;
  let _ on value, alias = {
    print("value = ");
    print-line(borrow(value));
    print("alias = ");
    print-line(borrow(alias))
  };
  let _ = value;
  let _ = alias;
  Unit
}

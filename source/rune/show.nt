import {
  layer,
  show {Show, show},
  string {join, string},
  string.show {escape},
}

define show-rune(ch: rune) -> string {
  let base = string.singleton(ch);
  let result on base = join(escape(base));
  let _ = base;
  result
}

constant as-show: show(rune) {
  Show{
    render := {
      (ch) => {
        show-rune(*ch)
      }
    },
  }
}

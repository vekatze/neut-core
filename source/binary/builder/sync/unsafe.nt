import {
  this::binary.builder {_append},
  this::binary.builder.sync {
    _mutate,
    binary-builder,
  },
  this::memory.unsafe {memcpy},
  this::unit {unit},
}

define append-chunk(b: &binary-builder, ptr: pointer, size: int) -> unit {
  _mutate(b, (b) => {
    _append(b, size, (dest) => {
      memcpy(dest, ptr, size)
    })
  })
}
